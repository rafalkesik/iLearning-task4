<div class="overflow-x-auto">
  <table class="table">
    <!-- head -->
    <thead>
      <tr>
        <th><input type="checkbox" class="checkbox checkbox-sm" /></th>
        <th>Name (id)</th>
        <th>Email</th>
        <th>Status</th>
        <th>Last seen</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each.with_index do |user, i| %>
        <tr class="hover:bg-base-200">
          <td><input type="checkbox" class="checkbox checkbox-sm" id=<%= user.id %> /></td>
          <td><%= user.id %></td>
          <td><%= user.email %></td>
          <td><%= user.status %></td>
          <td><%= user.last_sign_in_at %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class='flex w-full'>
  <div class='w-1/2 flex max-sm:w-full'>
    <div class='mx-auto w-fit my-auto'>
      <h2>Sign up</h2>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <fieldset class="fieldset">
          <%= f.label :email, class: 'label' %> 
          <%= f.text_field :email, class: 'input', placeholder: 'eg. bob@gmail.com',
                          autocomplete: "email", required: true %>

          <%= f.label :password, class: 'label' %> 
          <%= f.password_field :password, class: 'input',
                                autocomplete: 'new-password', required: true %>
          
          <%= f.label :password_confirmation, class: 'label' %> 
          <%= f.password_field :password_confirmation, class: 'input',
                                autocomplete: 'new-password', required: true %>

          <%= f.label :full_name, class: 'label mt-5' %> 
          <%= f.text_field :full_name, class: 'input',
                           placeholder: 'eg. Bob Kowalsky',
                           required: true %>
          
          <%= f.label :job_position, class: 'label' %> 
          <%= f.text_field :job_position, class: 'input',
                           placeholder: 'eg. Marketing Manager',
                           required: true %>
        </fieldset>

        <%= f.submit "Sign up", class: 'btn btn-primary mt-3' %>
      <% end %>

      <div class='mt-10'>
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>

  <div class='w-1/2 max-sm:hidden'>
    <%= image_tag 'logo_big.png', class: 'w-90' %>
  </div>
</div>
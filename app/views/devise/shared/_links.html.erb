<%- if controller_name != 'sessions' %>
  <p>
    Already signed up?
    <%= link_to "Log in", new_session_path(resource_name), class: 'font-bold' %>
  </p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p>
    Need a new account?
    <%= link_to "Sign up", new_registration_path(resource_name), class: 'font-bold' %>
  </p>
<% end %>


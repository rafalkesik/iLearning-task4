<div class='flex w-full'>
  <div class='w-1/2 flex max-sm:w-full'>
    <div class='mx-auto w-fit my-auto'>
      <h2>Log in</h2>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <fieldset class="fieldset">
          <%= f.label :email, class: 'label' %>
          <%= f.text_field :email, class: 'input', placeholder: 'Your Email',
                           autocomplete: "current-password" %>
          <%= f.label :password, class: 'label' %>
          <%= f.password_field :password, class: 'input',
                                placeholder: 'Your Password',
                                autocomplete: "current-password" %>
          <% if devise_mapping.rememberable? %>
            <p><%= f.check_box :remember_me %>
            <%= f.label :remember_me %></p>
          <% end %>
        </fieldset>
        <%= f.submit "Log in", class: 'btn btn-primary mt-3' %>
      <% end %>
      <div class='mt-10'>
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>

  <div class='w-1/2 max-sm:hidden'>
    <%= image_tag 'logo_big.png', class: 'w-90' %>
  </div>
</div>